<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bianca Carolina | Portfólio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #6b0404;
            color: #4a2430;
        }

        /* 🌸 CABEÇALHO */

        .topo-unico {
            min-height: 330px;
            background: linear-gradient(135deg, #3c0816, #890202, #3e0a0a);

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            text-align: center;
            padding: 30px;

            position: relative;
            overflow: hidden;
        }

        .topo-unico::before {
            content: "♡  ✦  ♡  ✧  ♡";
            position: absolute;
            top: 2px;
            left: 20px;

            font-size: 25px;
            color: rgba(215, 159, 75, 0.7);
            letter-spacing: 10px;
        }

        .topo-unico::after {
            content: "✧  ♡  ✦  ♡";
            position: absolute;
            bottom: 20px;
            right: 20px;

            font-size: 25px;
            color: rgba(186, 139, 51, 0.7);
            letter-spacing: 10px;
        }


        /* 📸 FOTO */

               .foto {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgb(29, 26, 26);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
            margin-bottom: 0px;}


        /* ✨ TÍTULO */

        .topo-unico h1 {
            font-size: 42px;

            color: rgb(239, 229, 229);

            text-shadow: 3px 3px 0px #d38c08;

            margin-bottom: 10px;
        }

        .topo-unico p {
            font-size: 18px;
            color: white;
        }


        /* 🎀 MENU */

        .centralizar {
            list-style: none;

            display: flex;
            justify-content: center;
            align-items: stretch;

            flex-wrap: wrap;

            gap: 30px;

            padding: 60px 20px;
        }


        /* 💗 CARDS */

        .centralizar li {
            width: 240px;

            background: rgb(216, 206, 181);

            border-radius: 25px;

            border: 3px solid #463239;

            box-shadow: 0 8px 0px #42363b;

            transition: 0.3s;

            overflow: hidden;
        }


        .centralizar li:hover {
            transform: translateY(-10px) rotate(-2deg);

            box-shadow: 0 15px 0px #222121;
        }


        .centralizar a {
            display: block;

            padding: 30px 15px;

            color: #513545;

            text-decoration: none;

            text-align: center;
        }


        .centralizar h2 {
            font-size: 22px;

            margin-bottom: 8px;
        }


        /*  ÍCONES */

        .centralizar li::before {
            display: block;

            font-size: 40px;

            padding-top: 20px;
        }


        .centralizar li:nth-child(1)::before {
            content: "";
        }

        .centralizar li:nth-child(2)::before {
            content: "";
        }


        /* 📷 INSTAGRAM */

        .instagram {
            text-align: center;

            padding: 10px 20px 45px;
        }


        .instagram a {
            display: inline-block;

            background: rgb(217, 216, 193);

            color: #210c15;

            text-decoration: none;

            padding: 15px 25px;

            border-radius: 30px;

            border: 2px solid #47363c;

            box-shadow: 0 5px 0px #41383b;

            transition: 0.3s;
        }


        .instagram a:hover {
            transform: translateY(-5px);

            background: #bbae95;

            box-shadow: 0 8px 0px #161315;
        }


        /* 💗 RODAPÉ */

        footer {
            text-align: center;

            padding: 25px;

            background: #510505;

            color: white;

            font-size: 14px;
        }


        /* 📱 CELULAR */

        @media (max-width: 600px) {

            .topo-unico {
                min-height: 300px;
            }

            .topo-unico h1 {
                font-size: 30px;
            }

            .topo-unico p {
                font-size: 16px;
            }

            .foto {
                width: 110px;
                height: 110px;
            }

            .centralizar {
                flex-direction: column;

                align-items: center;

                padding: 40px 20px;
            }

            .centralizar li {
                width: 90%;

                max-width: 330px;
            }
        }

    </style>
</head>


<body>

    <!-- 🌸 CABEÇALHO -->

    <header class="topo-unico">

        <!-- COLOQUE SUA FOTO AQUI -->
        <img src="foto.jpg"
             alt="Foto de Bianca Carolina"
             class="foto">

        <h1>♡ Bianca Carolina ♡</h1>

        <p>Bem-vindo ao meu cantinho! ✨</p>

    </header>


    <!-- 🎀 MENU -->

    <nav>

        <ul class="centralizar">

            <li>
                <a href="sobre.html">
                    <h2>Sobre mim</h2>
                    <span>Conheça um pouquinho de mim ♡</span>
                </a>
            </li>


            <li>
                <a href="projetos.html">
                    <h2>Projetos</h2>
                    <span>Conheça meus projetos ✨</span>
                </a>
            </li>

        </ul>

    </nav>


    <!-- 📷 INSTAGRAM -->

    <section class="instagram">

        <a href="https://www.instagram.com/biac.lr/"
           target="_blank"
           rel="noopener noreferrer">

            📷 Instagram • @biac.lr

        </a>

    </section>



    <!-- 💗 RODAPÉ -->

    <footer>

        © 2026 Bianca Carolina •

    </footer>

</body>

</html>
